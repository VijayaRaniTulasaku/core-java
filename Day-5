HYBRID
-->PROGRAM

interface pet{
    void play();
}
class animal{
    void eat(){
        System.out.println("animal is eating");
    }
}
class dog extends animal implements pet{
    public void play(){
        System.out.println("animal is playing games");
    }
    void mam(){
        System.out.println("mam is playing with animals");
    }

}
class cat extends animal implements pet{
    public void play(){
        System.out.println("hello world");
    }
    void men(){
        System.out.println("men is playing game");
    }
}
class Hybrid{
    public static void main(String args[]){
        dog obj = new dog();
        cat obj1 = new cat();
        obj.eat();
        obj.mam();
        obj.play();
        obj1.eat();
        obj1.men();
        obj1.play();
    }
}

