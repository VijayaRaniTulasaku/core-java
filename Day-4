-->Methods
import java.util.*;
class Stringbuilder
{
    public static void main(String args[])
    {
        StringBuilder obj=new StringBuilder("Hello");
        obj.insert(2,"is");
        System.out.println(obj);
        obj.replace(1,3,"world");
        System.out.println(obj);
        obj.delete(1,3);
        System.out.println(obj);
        obj.deleteCharAt(4);
        System.out.println(obj);
        obj.reverse();
        System.out.println(obj);
        obj.capacity();
        System.out.println(obj);
        obj.charAt(0);
        System.out.println(obj);
        obj.setCharAt(1,'v');
        System.out.println(obj);
        obj.toString();
        System.out.println(obj);
    }
}


