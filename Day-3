--> Program(Swapping)
import java.util.Scanner;
class Swapping {
    public static void main(String[] args) {
       int a[]={1,2,3,4,5,6};
       int left=0;
       int right=a.length-1;
       while(left<right)
       {
        int temp=a[left];
        a[left]=a[right];
        a[right]=temp;
        left++;
        right--;
       }
       for(int i=0;i<=a.length-1;i++)
       {
        System.out.print(a[i]);
       }
    }
}
